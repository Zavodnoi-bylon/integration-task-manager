# Copy to the closed server config directory as aio-advertisers.env.
# Keep mode 0600. Never commit the populated file.
# The worker discovers tenants and synchronizes only the configured bot mapping.
AIO_TOKEN=

AIO_API_BASE_URL=https://app.aio.tech
AIO_ADVERTISER_PROFILES=kalisto,mephisto
AIO_ADVERTISER_SYNC_SECONDS=43200
AIO_ADVERTISER_FULL_SYNC_SECONDS=604800
AIO_ADVERTISER_DETAIL_DELAY_SECONDS=1.1
AIO_ADVERTISER_PAGE_SIZE=100
AIO_ADVERTISER_MAX_PAGES=100
